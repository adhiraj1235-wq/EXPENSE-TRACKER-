# Compiled Java binaries & Maven build output
**/target/
target/
*.class
*.jar
*.war
*.ear

# Node & Frontend build output
**/node_modules/
node_modules/
frontend/dist/
frontend/.vite/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Database & Runtime logs
*.log
*.mv.db
*.trace.db
*.h2.db

# IDE & Editor files
.idea/
*.iml
.vscode/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.DS_Store
Thumbs.db
